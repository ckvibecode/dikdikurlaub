# PostgreSQL-Verbindung (z.B. von Render Postgres, Neon, Supabase, ...)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Zufälliger, mind. 32 Zeichen langer String zum Signieren der Session-Cookies.
# Generieren z.B. mit: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Optional, nur fuer prisma/seed.ts
TRIP_CODE="DIKDIK2026"
TRIP_NAME="DikDik2026"
TRIP_START_DATE="2026-07-01"
TRIP_END_DATE="2026-07-08"
